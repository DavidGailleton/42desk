#!/bin/bash
# 42desk-start <desktop command...>: run by junest-session inside JuNest's
# private session bus. Records the session for live rice reloads, applies the
# rice (if any), then runs the desktop and stops the rice's daemons after it.
state=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/42-junest
install -d -m 700 "$state"
# Read by `42desk rice` from the host (junest-session removes it at the end).
printf 'DISPLAY=%s DBUS_SESSION_BUS_ADDRESS=%s\n' "$DISPLAY" "$DBUS_SESSION_BUS_ADDRESS" >"$state/session.env"

42desk-rice-apply start

# XFCE's keys live in xfconf: add the 42desk ones, unless the user set these keys.
if [[ ${XDG_CURRENT_DESKTOP:-} == XFCE ]]; then
    for kv in '<Super>space=rofi -show drun' '<Super><Shift>space=42desk-kbd-next' '<Super>b=42desk-gnome'; do
        p="/commands/custom/${kv%%=*}"
        xfconf-query -c xfce4-keyboard-shortcuts -p "$p" >/dev/null 2>&1 ||
            xfconf-query -c xfce4-keyboard-shortcuts -p "$p" -n -t string -s "${kv#*=}"
    done
fi

"$@"
rc=$?
42desk-rice-apply stop-daemons
exit "$rc"
