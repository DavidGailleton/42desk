# 42desk profile: plain KEY=value lines, read by 42desk (never run).
# @USER@ stands for the login of whoever installs it. A missing key keeps
# that step's current choice. Example profile shipped with 42desk.
PROFILE_NAME=Dev bspwm: Tokyo Night, kitty, neovim, VS Code, debugging tools
DESKTOP=bspwm
RICE=tokyonight
APPS=kitty firefox neovim code thunar zathura mpv gdb valgrind clang btop zsh
BINDS=/goinfre/@USER@ /sgoinfre/@USER@
FT_APPS=norminette header42
