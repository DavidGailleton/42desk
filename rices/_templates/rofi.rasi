/* {{MARK}} */
/* No built-in theme underneath: everything below is the whole look. */
@theme "/dev/null"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "{{ICONS}}";
    font: "{{FONT}} {{FONT_SIZE}}";
    drun-display-format: "{name}";
    display-drun: "apps";
    display-run: "run";
    display-window: "windows";
}

* {
    bg: {{BG}};
    bg-alt: {{BG_ALT}};
    fg: {{FG}};
    dim: {{FG_DIM}};
    accent: {{ACCENT}};
    background-color: transparent;
    text-color: @fg;
}

window {
    transparency: "real";
    width: 38%;
    background-color: @bg;
    border: {{BORDER}}px;
    border-color: @accent;
    border-radius: {{RADIUS}}px;
    padding: 16px;
}

inputbar {
    children: [ prompt, entry ];
    spacing: 10px;
    padding: 10px;
    background-color: @bg-alt;
    border-radius: {{RADIUS}}px;
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "search";
    placeholder-color: @dim;
}

listview {
    lines: 8;
    scrollbar: false;
    spacing: 4px;
    margin: 12px 0 0 0;
}

element {
    padding: 8px 10px;
    spacing: 10px;
    border-radius: {{RADIUS}}px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.urgent, element alternate.urgent, element selected.urgent {
    background-color: transparent;
    text-color: {{URGENT}};
}

element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @accent;
}

element selected.normal, element selected.active {
    background-color: @accent;
    text-color: @bg;
}

scrollbar {
    enabled: false;
}

element-icon {
    size: 22px;
}

element-text {
    text-color: inherit;
}
